<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<!-- One collapsible section card, shared by the sidebar and the flyout. -->
<t t-name="saturn_backend.MenuSection" owl="1">
    <div class="subnav_sect rolkit py-1" t-att-class="sectionClass">
        <div class="d-flex align-items-center cursor-pointer subnav_sect_header user-select-none"
             t-att-aria-expanded="this.saturn.isSectionOpen(section.id) ? 'true' : 'false'"
             t-on-click="() => this.saturn.toggleSection(section.id)">
            <div class="u_app_icon me-2 rounded position-relative d-flex justify-content-center align-items-center ratio ratio-1x1">
                <i t-att-class="this.sectionIcon(section.name) + ' position-relative w-auto h-auto'"/>
            </div>
            <span class="fs-7 fw-sbold" t-out="section.name"/>
            <i class="ms-auto"
               t-att-class="this.saturn.isSectionOpen(section.id) ? 'ri-indeterminate-circle-line' : 'ri-add-circle-line'"/>
        </div>
        <div class="subnav_sect_body" t-att-class="{ 'is-open': this.saturn.isSectionOpen(section.id) }">
            <div class="subnav_sect_body_inner">
                <t t-foreach="this.flatten(section)" t-as="row" t-key="row.id">
                    <div t-if="row.type === 'group'" class="dropdown-menu_group dropdown-header mb-1" t-out="row.name"/>
                    <a t-else=""
                       class="o-dropdown-item dropdown-item o-navigable subnav_entry"
                       t-att-class="{ on: this.isCurrentEntry(row.menu) }"
                       role="menuitem" tabindex="0"
                       t-att-href="this.saturn.menuHref(row.menu)"
                       t-att-data-menu-xmlid="row.menu.xmlid"
                       t-on-click="(ev) => this.onEntryClick(row.menu, ev)">
                        <span class="indicator-pill pe-none"/>
                        <span class="text-truncate pe-none" t-att-title="row.menu.name" t-out="row.menu.name"/>
                    </a>
                </t>
            </div>
        </div>
    </div>
</t>

<t t-name="saturn_backend.Subnav" owl="1">
    <div class="subnav_wrapper d-flex flex-column flex-wrap"
         t-att-style="this.props.maxHeight ? `max-height: min(719px, ${this.props.maxHeight}px)` : undefined"
         t-on-mouseenter="() => this.props.onMouseEnter and this.props.onMouseEnter()"
         t-on-mouseleave="() => this.props.onMouseLeave and this.props.onMouseLeave()">
        <t t-foreach="this.sections" t-as="section" t-key="section.id">
            <t t-call="saturn_backend.MenuSection"><t t-set="sectionClass" t-value="'border rounded ps-2 pe-1'"/></t>
        </t>
    </div>
</t>

</templates>
