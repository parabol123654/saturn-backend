<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Odoo 16 picks the dark bundles from the cookie alone, so no cookie
         means light. Ask ir.http instead: cookie, then the user's stored
         setting, then dark. -->
    <template id="webclient_bootstrap" inherit_id="web.webclient_bootstrap" name="Saturn: colour scheme">
        <xpath expr="//t[@t-call-assets='web.dark_mode_assets_common']/.." position="attributes">
            <attribute name="t-if">request.env['ir.http'].color_scheme() == 'dark'</attribute>
        </xpath>
    </template>

</odoo>
