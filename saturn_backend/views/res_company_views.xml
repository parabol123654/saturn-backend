<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form_saturn" model="ir.ui.view">
        <field name="name">res.company.form.saturn</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Backend chrome" name="saturn_chrome">
                    <group>
                        <field name="saturn_logo" widget="image" class="oe_avatar"/>
                        <field name="saturn_logo_mini" widget="image" class="oe_avatar"/>
                    </group>
                    <group>
                        <field name="saturn_background" widget="image" class="oe_avatar"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
